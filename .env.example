# All optional. Set in Vercel (build-time) unless noted.
NEXT_PUBLIC_SITE_URL=https://figurecompare.com
# (eBay Partner Network: campaign 5339155912 is hard-coded in src/lib/affiliate.ts; no variable)
# Amazon Associates tags, one per marketplace program (US falls back to the family's tag)
AMAZON_TAG_US=
AMAZON_TAG_UK=
AMAZON_TAG_CA=
AMAZON_TAG_AU=
AMAZON_TAG_EU=
# HobbyLink Japan affiliate query string, e.g. ref=XXXX
HLJ_AFFILIATE_REF=
# eBay Marketplace Account Deletion verification token (Vercel, runtime)
EBAY_VERIFICATION_TOKEN=
# GitHub Actions secrets only (never Vercel): eBay Browse API keys
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# Local development against the fixture instead of data/public:
# FIGURE_DATA_DIR=tests/fixtures/data
